# ==========================================
# RESELLER HQ - VARIABILI D'AMBIENTE
# ==========================================
# IMPORTANTE: Copia questo file in `.env` e cambia TUTTI i valori in produzione!
# Non committare mai il file .env reale su Git.

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/reseller_hq"
# Per SQLite (sviluppo): DATABASE_URL="file:./dev.db"

# ==========================================
# SICUREZZA - JWT E COOKIES
# ==========================================
# Genera con: openssl rand -base64 64
JWT_ACCESS_SECRET="CAMBIAMI-genera-con-openssl-rand-base64-64-CARATTERI-RANDOM"
JWT_REFRESH_SECRET="CAMBIAMI-AL-TRO-SEGRETO-DIVERSO-DALLACCESS-64-CARATTERI"

# Durata token
JWT_ACCESS_EXPIRES="15m"      # Access token: breve durata
JWT_REFRESH_EXPIRES="7d"      # Refresh token: settimana

# Chiave per cifrare i secret 2FA nel DB (32 byte esadecimali = 64 chars)
# Genera con: openssl rand -hex 32
ENCRYPTION_KEY="CAMBIAMI-64-caratteri-hex-per-cifratura-AES-256-GCM-2FA-secrets"

# ==========================================
# CORS - DOMINI AUTORIZZATI
# ==========================================
# Lista dei domini autorizzati separati da virgola (no spazi)
# In produzione metti SOLO il tuo dominio
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://tuodominio.com"

# ==========================================
# COOKIE
# ==========================================
COOKIE_DOMAIN=""              # In produzione: tuodominio.com (senza https)
COOKIE_SECURE="false"         # In produzione: "true" (richiede HTTPS)

# ==========================================
# IA - GROQ
# ==========================================
GROQ_API_KEY="gsk_la-tua-chiave-groq"

# ==========================================
# TRACKING SPEDIZIONI - 17TRACK (opzionale)
# ==========================================
# Registrati gratis su https://17track.net/en/api
# Piano gratuito: 100 tracking/mese. Supporta BRT, GLS, Poste Italiane, DHL, UPS, FedEx, ecc.
# Senza questa chiave il tracking manuale funziona ma non si aggiorna automaticamente.
# TRACKING_17TRACK_KEY="la-tua-chiave-17track"

# ==========================================
# SERVER
# ==========================================
PORT=3000
NODE_ENV="development"        # "development" | "production"

# ==========================================
# RATE LIMITING (richieste per finestra)
# ==========================================
RATE_LIMIT_LOGIN=5            # Max tentativi login per IP ogni 15min
RATE_LIMIT_API=100            # Max chiamate API per IP ogni 15min
RATE_LIMIT_AI=20              # Max chiamate IA per utente ogni ora
