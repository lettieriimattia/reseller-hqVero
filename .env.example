# ==========================================
# RESELLER HQ - VARIABILI D'AMBIENTE
# ==========================================
# IMPORTANTE: Copia questo file in `.env` e cambia TUTTI i valori in produzione!
# Non committare mai il file .env reale su Git.

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/reseller_hq"
# Per SQLite (sviluppo): DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="postgresql"    # deve combaciare col datasource in prisma/schema.prisma
# Solo per scripts/migrate-data.ts (migrazione una tantum tra due DB): NON servono in produzione.
# SOURCE_DATABASE_URL=""
# DEST_DATABASE_URL=""
# BACKUP_DATABASE_URL=""          # target di scripts/backup-db.ts, se diverso dal DB principale

# ==========================================
# SICUREZZA - JWT E COOKIES
# ==========================================
# Genera con: openssl rand -base64 64
JWT_ACCESS_SECRET="CAMBIAMI-genera-con-openssl-rand-base64-64-CARATTERI-RANDOM"
JWT_REFRESH_SECRET="CAMBIAMI-AL-TRO-SEGRETO-DIVERSO-DALLACCESS-64-CARATTERI"

# Durata token
JWT_ACCESS_EXPIRES="15m"      # Access token: breve durata
JWT_REFRESH_EXPIRES="7d"      # Refresh token: settimana

# Chiave per cifrare i secret 2FA nel DB (32 byte esadecimali = 64 chars)
# Genera con: openssl rand -hex 32
ENCRYPTION_KEY="CAMBIAMI-64-caratteri-hex-per-cifratura-AES-256-GCM-2FA-secrets"

# ==========================================
# CORS - DOMINI AUTORIZZATI
# ==========================================
# Lista dei domini autorizzati separati da virgola (no spazi)
# In produzione metti SOLO il tuo dominio
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://tuodominio.com"

# ==========================================
# COOKIE
# ==========================================
COOKIE_DOMAIN=""              # In produzione: tuodominio.com (senza https)
COOKIE_SECURE="false"         # In produzione: "true" (richiede HTTPS)
# COOKIE_SAME_SITE="lax"      # "lax" | "strict" | "none" (none richiede COOKIE_SECURE=true)

# ==========================================
# CANCELLO BETA — nascondi l'app ai non invitati
# ==========================================
# Se impostata: /app senza sessione valida NON mostra il login, rimanda a /waitlist.
# Manda ai tester il link https://tuodominio.com/app?beta=IL_CODICE (una volta sola):
# pianta un cookie di 1 anno, dopo possono aprire /app normalmente. Vuota = gate disattivato
# (comportamento attuale: /app sempre raggiungibile).
# BETA_ACCESS_KEY=""

# ==========================================
# MODALITA' DEMO (video/screenshot senza login reale)
# ==========================================
# DEMO_ENABLED="false"
# DEMO_EMAIL=""                 # account che /auth/demo-login apre automaticamente

# ==========================================
# MANUTENZIONE / JOB DI BACKGROUND
# ==========================================
# MAINTENANCE_MODE="false"      # true = app in manutenzione (blocca l'accesso non-admin)
# ENABLE_BACKGROUND_JOBS="true" # cron interni (report giornaliero, sweep foto, ecc.)
# MONITOR_HOUR="8"              # ora (0-23) del report/monitor giornaliero
# LOG_RETENTION_DAYS="30"       # giorni di conservazione audit log
# CATALOG_KEEP="5000"           # righe massime da tenere in CatalogItem durante la pulizia
# Flag one-shot per lanciare manualmente uno script all'avvio (poi rimuovere la variabile):
# RUN_MAINTENANCE_NOW="false"
# RUN_MONITOR_NOW="false"
# RUN_PHOTO_MIGRATION="false"
# RUN_WAREHOUSE_MIGRATION="false"

# ==========================================
# IA - GROQ (riconoscimento prodotti, assistente)
# ==========================================
GROQ_API_KEY="gsk_la-tua-chiave-groq"

# --- Alternativa: Gemini Vision (di default si usa Groq) ---
# USE_GEMINI_VISION="false"
# GEMINI_API_KEY=""
# GEMINI_VISION_MODEL=""
# GEMINI_FALLBACK_MODEL=""
# GEMINI_THINKING_BUDGET=""
# GEMINI_THINKING_LEVEL=""

# ==========================================
# FOTO CATALOGO - KICKSDB (kicks.dev)
# ==========================================
# Fonte PRIMARIA foto sneaker/apparel/accessori. Piano REALE = 1000 richieste/MESE.
KICKSDB_API_KEY=""
# Tetti di sicurezza (collo di bottiglia unico, vedi src/services/kicksdb.service.ts):
# KICKSDB_MONTHLY_CAP="950"          # tetto mensile GLOBALE (app + checker pubblico)
# KICKSDB_DAILY_CAP="60"             # tetto giornaliero GLOBALE
# PUBLIC_KICKS_MONTHLY_CAP="400"     # fetta mensile riservata al checker pubblico
# KICKSDB_PUBLIC_DAILY_CAP="30"      # fetta giornaliera riservata al checker pubblico

# ==========================================
# FOTO/PREZZI CATALOGO - STOCKX (ripiego)
# ==========================================
# STOCKX_CLIENT_ID=""
# STOCKX_CLIENT_SECRET=""
# STOCKX_API_KEY=""
# STOCKX_REDIRECT_URI=""

# ==========================================
# VALUTAZIONE PREZZI
# ==========================================
# Carte GRADATE (PSA/BGS/CGC) via tcgpricelookup.com — su Render → Environment.
TCGPRICELOOKUP_API_KEY=""
# TCGPRICELOOKUP_BASE_URL=""            # opzionale, override endpoint
# TCGPRICELOOKUP_DAILY_LIMIT="100"      # richieste gradate/giorno del tuo piano
# Prova "quanto vale" sulla landing pubblica: ricerche gratis al giorno PER IP, poi si iscrivono.
# PUBLIC_PRICE_CHECKS_PER_DAY="3"
# PUBLIC_PHOTO_SCANS_PER_DAY="1"        # scan da FOTO (vision IA, costa di più): limite separato
# PUBLIC_WL_BONUS_PER_DAY="1"           # valutazioni extra/giorno per chi si iscrive alla waitlist
# PUBLIC_CHECKER_ENABLED="true"         # false = checker pubblico OFF (mostra solo la waitlist)
# PUBLIC_AI_MONTHLY_CAP="3000"          # tetto mensile scan foto (la voce più cara)
# PUBLIC_CARDS_MONTHLY_CAP="3000"       # tetto mensile valutazione carte

# Pokémon (pokemontcg.io) — chiave opzionale, alza i limiti di rate.
# POKEMONTCG_API_KEY=""

# Vinili/Dischi — Discogs
# DISCOGS_TOKEN=""

# Orologi — Apify (scraper Chrono24)
# APIFY_TOKEN=""
# APIFY_CHRONO24_ACTOR=""
# APIFY_VESTIAIRE_ACTOR=""
# APIFY_MONTHLY_LIMIT="100"

# LEGO — BrickEconomy (CONSIGLIATA: valore di mercato nuovo/usato, chiave gratis, NIENTE vincolo venditore).
# Crea un account free su brickeconomy.com e richiedi la chiave su https://www.brickeconomy.com/api-reference
# BRICKECONOMY_API_KEY=""
# BRICKECONOMY_BASE_URL=""
# LEGO — API UFFICIALE BrickLink (prezzi reali ma richiede account VENDITORE su BrickLink).
# Registra 4 chiavi gratis (serve un account BrickLink) su:
#   https://www.bricklink.com/v2/api/register_consumer.page  → nel campo IP metti  0.0.0.0  (= qualsiasi IP)
# BRICKLINK_CONSUMER_KEY=""
# BRICKLINK_CONSUMER_SECRET=""
# BRICKLINK_TOKEN=""
# BRICKLINK_TOKEN_SECRET=""
# LEGO (ripiego) — scraper BrickLink via Apify. ⚠️ spesso bloccato da BrickLink con "Human Verification".
# APIFY_LEGO_ACTOR="jungle_synthesizer/bricklink-lego-part-minifig-price-scraper"

# eBay — comps per la valutazione di mercato (anti-falsi)
# EBAY_APP_ID=""
# EBAY_CERT_ID=""
# EBAY_CLIENT_ID=""
# EBAY_CLIENT_SECRET=""
EBAY_MARKETPLACE="EBAY_IT"

# ==========================================
# IMMAGINI - CLOUDINARY (hosting foto prodotto/utente)
# ==========================================
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ==========================================
# EMAIL - BREVO (transazionali: reset password, notifiche)
# ==========================================
# BREVO_API_KEY=""
# EMAIL_FROM=""

# ==========================================
# NOTIFICHE PUSH (Web Push / VAPID)
# ==========================================
# Le chiavi pubblica/privata VAPID stanno nel DB (tabella Setting), generate al primo avvio.
# VAPID_SUBJECT="mailto:tuaemail@esempio.com"

# ==========================================
# TELEGRAM - notifiche admin + report giornaliero (@HQVaultBOT)
# ==========================================
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# TELEGRAM_OWNER_EMAIL=""
# ALERT_EMAIL=""                # ripiego email se Telegram non è configurato

# ==========================================
# PAGAMENTI - STRIPE (abbonamenti piani a pagamento)
# ==========================================
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PLATFORM_FEE_EUR=""           # commissione piattaforma sulle vendite marketplace

# ==========================================
# SPEDIZIONI - SENDCLOUD (etichette) + 17TRACK (tracking, opzionale)
# ==========================================
# SENDCLOUD_API_KEY=""
# SENDCLOUD_API_SECRET=""
# Registrati gratis su https://17track.net/en/api
# Piano gratuito: 100 tracking/mese. Supporta BRT, GLS, Poste Italiane, DHL, UPS, FedEx, ecc.
# Senza questa chiave il tracking manuale funziona ma non si aggiorna automaticamente.
# TRACKING_17TRACK_KEY="la-tua-chiave-17track"

# ==========================================
# URL PUBBLICO DEL SERVIZIO (self-ping /health, link nelle email)
# ==========================================
# APP_URL="https://tuodominio.com"

# ==========================================
# SERVER
# ==========================================
PORT=3000
NODE_ENV="development"        # "development" | "production"

# ==========================================
# RATE LIMITING (richieste per finestra)
# ==========================================
RATE_LIMIT_LOGIN=5            # Max tentativi login per IP ogni 15min
RATE_LIMIT_API=100            # Max chiamate API per IP ogni 15min
RATE_LIMIT_AI=20              # Max chiamate IA per utente ogni ora
