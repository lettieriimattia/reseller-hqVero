// Prisma Schema - Reseller HQ v2.0
// Aggiornato con: 2FA, RefreshToken, AuditLog, Notification, MarketPrice

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime: connessione POOLED (DATABASE_URL con host -pooler) → regge tante connessioni.
  url       = env("DATABASE_URL")
  // Migrazioni / db push: connessione DIRETTA (DIRECT_URL senza -pooler).
  directUrl = env("DIRECT_URL")
}

// ==========================================
// UTENTE
// ==========================================
model User {
  id                String         @id @default(cuid())
  email             String         @unique
  password          String
  name              String
  
  // 2FA - autenticazione a due fattori (TOTP - Google Authenticator)
  twoFactorEnabled  Boolean        @default(false)
  twoFactorSecret   String?        // Cifrato a riposo (vedi utils/security.ts)
  twoFactorBackup   String?        // Codici di backup (JSON cifrato)
  
  // Consenso comunicazioni email (opzionale, revocabile)
  marketingConsent  Boolean        @default(false)

  // Verifica email (default true: gli account esistenti restano verificati; i nuovi partono false)
  emailVerified     Boolean        @default(true)
  emailVerifyCode   String?        // codice OTP a 6 cifre
  emailVerifyExpires DateTime?
  passwordResetCode    String?     // codice OTP a 6 cifre per il recupero password
  passwordResetExpires DateTime?

  // Preferenze notifiche push: JSON { offers, messages, sales, shipping, disputes, team, insights }.
  // null = tutte attive (default). Le notifiche di sicurezza non sono disattivabili.
  notifPrefs        String?

  // Piano di abbonamento: "free" | "starter" | "pro" | "business" (vedi config/plans.ts)
  plan              String         @default("free")

  // Stripe Connect: conto del venditore per incassare i pagamenti dei prodotti.
  stripeAccountId      String?     // id account Express (acct_...)
  stripeChargesEnabled Boolean     @default(false) // onboarding completato → può incassare

  // Sicurezza
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?      // Account temporaneamente bloccato dopo X tentativi
  lastLoginAt       DateTime?
  lastLoginIp       String?
  webauthnChallenge String?        // challenge temporanea per Face ID / passkey (WebAuthn)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  memberships       Membership[]
  products          Product[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  inventoryLogs     InventoryLog[]
  webauthnCreds     WebAuthnCredential[]

  @@index([email])
}

// Credenziale WebAuthn / Passkey (Face ID, Touch ID, Windows Hello)
model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique          // id credenziale (base64url)
  publicKey    Bytes                      // chiave pubblica
  counter      BigInt   @default(0)       // contatore anti-clonazione
  transports   String?                    // JSON array (es. ["internal"])
  deviceName   String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ==========================================
// WAREHOUSE (Magazzino/Reparto)
// ==========================================
model Warehouse {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  inviteCodeExpiresAt DateTime?  // I codici invito scadono dopo 30 giorni
  aiConfig    String?            // JSON con fields, scanPrompt, conditionOptions generati da IA

  // Gerarchia: parentId null = reparto top-level; valorizzato = sotto-magazzino del reparto.
  // Ogni sotto-magazzino è un Warehouse a sé (propri soci, %, codice invito, prodotti).
  parentId    String?
  parent      Warehouse?   @relation("WarehouseHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Warehouse[]  @relation("WarehouseHierarchy")

  // Categoria IA del reparto (per template/riconoscimento): i sotto-magazzini ereditano
  // quella del genitore. Null per i reparti = si usa il nome (compat).
  category    String?

  // Divisione profitti predefinita per questo warehouse (JSON string con array di {userId, percentage})
  // Può essere sovrascritto a livello di singolo prodotto tramite customShares
  defaultProfitShares String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     Membership[]

  @@index([inviteCode])
  @@index([parentId])
}

// ==========================================
// MEMBERSHIP (relazione User <-> Warehouse)
// ==========================================
model Membership {
  id          String     @id @default(cuid())
  role        String     // "OWNER" | "MEMBER"
  percentage  Float      @default(0)   // quota UTILI (divisione del profitto)
  costPercentage Float   @default(0)   // quota COSTI (chi sostiene i costi d'acquisto), indipendente dagli utili
  
  userId      String
  warehouseId String
  
  createdAt   DateTime   @default(now())
  
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  @@unique([userId, warehouseId])
  @@index([userId])
  @@index([warehouseId])
}

// ==========================================
// PRODOTTO
// ==========================================
model Product {
  id             String     @id @default(cuid())
  category       String
  brand          String
  name           String
  size           String
  condition      String
  
  purchasePrice  Float
  salePrice      Float?
  platform       String?
  fees           Float?
  customer       String?    // identificativo cliente alla vendita (nome/@social/codice) — facoltativo
  supplier       String?    // da CHI ho acquistato il pezzo (fornitore/venditore) — facoltativo
  quickSalePrice Float?     // "sell panic": prezzo di svendita rapida stimato (per valore liquidazione)

  status         String     @default("IN STOCK") // "IN STOCK" | "RESERVED" | "PAGATO" | "VENDUTO"
  customShares   String?    // JSON string con quote dei soci

  // Conto vendita: il prodotto è di un terzo (consignor). Nome obbligatorio se attivo,
  // percentuale facoltativa (quota che spetta al conto vendita sul ricavo).
  consignmentName    String?
  consignmentPercent Float?

  // Override divisione profitti per questo specifico prodotto
  // Se null, usa defaultProfitShares del warehouse
  profitShareOverride String?

  // Divisione costi d'acquisto: chi ha pagato quanto all'acquisto
  // JSON string con array di {userId, name, percentage, amount}
  // Es: [{"userId":"abc","name":"Mario","percentage":70,"amount":70},{"userId":"def","name":"Luca","percentage":30,"amount":30}]
  purchaseCostShares String?

  // Lotto d'acquisto: nome del lotto da cui proviene il prodotto (per raggruppare e
  // poter aggiungere altri pezzi a un lotto esistente). Null se prodotto singolo.
  lotName        String?
  
  // Foto prodotto (JSON array di base64 compressi, max 5)
  photos         String?

  // Stima mercato IA (calcolata in fase di scan/aggiunta)
  marketPriceMin Float?
  marketPriceMax Float?
  marketPriceAvg Float?
  authenticityScore Int?    // 0-100, valutazione legit check IA
  
  // Tracking spedizione
  trackingCode      String?
  trackingCarrier   String?
  trackingDirection String?   // "INBOUND" (acquisto in arrivo in stock) | "OUTBOUND" (spedizione di vendita). Default OUTBOUND.
  trackingStatus    String?   // "PENDING"|"IN_TRANSIT"|"OUT_FOR_DELIVERY"|"DELIVERED"|"EXCEPTION"|"RETURNED"
  trackingHistory   String?   // JSON array di eventi tracking
  trackingUpdatedAt DateTime?

  // Etichetta di spedizione salvata: una volta creata NON si rigenera, si riapre identica.
  // Demo: snapshot JSON {from,to,pkg,content,carrier,trackingCode}. Reale: {labelUrl}.
  shippingLabel     String?

  // Note libere
  notes          String?    // Note operative (es: cinturino usurato, scatola mancante)

  // Multi-canale (feature Pro): JSON array [{platform, status:"listed"|"sold"|"removed", url?}]
  // Quando il prodotto si vende, serve a ricordare di ritirarlo dagli altri canali.
  salesChannels  String?

  // Marketplace pubblico: l'articolo è in vetrina e cercabile da chiunque.
  isPublic       Boolean   @default(false)
  publicPrice    Float?    // prezzo di vendita pubblico (può differire da quello interno)
  shippingCost   Float?    // spese di spedizione a carico del compratore (per l'etichetta)
  sku            String?   // style code/SKU (es. DV1748-100) letto dalla scatola
  // Pagamento in-app (modello portafoglio): il compratore paga, i fondi restano "in attesa"
  // (status PAGATO) finché il venditore non li riscuote → solo allora diventa VENDUTO.
  paidSessionId  String?   // id Checkout Session Stripe
  buyerUserId    String?   // chi ha acquistato
  paidAt         DateTime? // quando è stato pagato
  heldAmount     Float?    // netto trattenuto per il venditore (prezzo + spedizione)
  deliveredConfirmedAt DateTime? // quando il compratore ha confermato "Consegnato" → fondi sbloccati
  withdrawnAt    DateTime? // quando il venditore ha riscosso (bonifico)

  // Finestra auto-conferma: se il compratore non conferma né contesta entro autoReleaseAt,
  // i fondi si sbloccano da soli al venditore (sweep cron). deliveredAt avvia la finestra (5gg).
  deliveredAt    DateTime? // consegna rilevata (tracking) o stimata (spedizione) → avvia finestra
  autoReleaseAt  DateTime? // oltre questa data, sblocco automatico se nessuna contestazione

  // Contestazioni / resi (escrow: i fondi restano congelati finché la disputa non si chiude).
  // disputeStatus: null | OPEN (compratore aperto) | ESCALATED (venditore contesta → admin)
  //               | RESOLVED_REFUND | RESOLVED_PARTIAL | RESOLVED_RELEASE
  disputeStatus    String?
  disputeReason    String?   // NOT_AS_DESCRIBED | COUNTERFEIT | DAMAGED | NOT_ARRIVED | WRONG_ITEM
  disputeNote      String?   // descrizione del compratore
  disputePhotos    String?   // JSON array di foto (base64) come prova
  disputeOpenedAt  DateTime?
  disputeResolvedAt DateTime?
  refundedAmount   Float?    // quanto è stato rimborsato al compratore
  refundedAt       DateTime?
  toShip         Boolean   @default(false) // marcato "da spedire" (es. venduto su un'altra piattaforma)
  sourceProductId String?  // se acquistato nel marketplace: id dell'articolo originale del venditore

  // Pilastro 1: Campi dinamici dalla CategoryTemplate (JSONB)
  attributes     String?      // Record<string, any> — popolato dal DynamicForm (JSON string per SQLite)

  // Pilastro 1: Soft delete — mai DELETE fisico dal DB
  deletedAt      DateTime?  // Non null = cancellato logicamente

  // Pilastro 2: Stato RESERVED (checkout in corso)
  reservedBy     String?    // userId che ha la reservation attiva
  reservedAt     DateTime?  // Scade dopo 15 minuti se non completata

  // Audit
  userId         String     // Chi l'ha inserito
  warehouseId    String?    // A quale warehouse appartiene (per autorizzazione)

  createdAt      DateTime   @default(now())
  soldAt         DateTime?
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id])
  inventoryLogs  InventoryLog[]

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([warehouseId])
  @@index([deletedAt])
}

// ==========================================
// REFRESH TOKEN (per gestire le sessioni)
// ==========================================
model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique // Hashato
  userId      String
  
  userAgent   String?
  ipAddress   String?
  
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
}

// ==========================================
// AUDIT LOG (tracciamento azioni sensibili)
// ==========================================
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // "LOGIN", "LOGIN_FAIL", "PRODUCT_CREATE", "PRODUCT_EDIT", "PRODUCT_SELL", "TEAM_JOIN", "2FA_ENABLE", ecc.
  resource    String?  // Es. productId, warehouseId
  metadata    String?  // JSON con dettagli aggiuntivi
  
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// NOTIFICATION (notifiche in-app)
// ==========================================
model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "SALE", "NEW_MEMBER", "PRICE_ALERT", "AI_INSIGHT", "SECURITY"
  title       String
  message     String
  link        String?  // Link interno (es. /products/123)
  read        Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, read])
  @@index([createdAt])
}

// ==========================================
// MARKET PRICE CACHE (cache stime prezzi)
// ==========================================
model MarketPrice {
  id          String   @id @default(cuid())
  category    String
  brand       String
  modelName   String
  size        String?

  minPrice    Float
  maxPrice    Float
  avgPrice    Float
  sampleSize  Int      // Numero di vendite analizzate
  source      String   // "GROQ_AI" | "MANUAL"

  createdAt   DateTime @default(now())
  expiresAt   DateTime // Le stime scadono dopo 7 giorni

  @@unique([category, brand, modelName, size])
  @@index([category, brand])
}

// ==========================================
// CATEGORY TEMPLATE (schema campi dinamici per categoria)
// Pilastro 1: Template Engine — niente categorie hardcoded.
// Ogni categoria può avere un set arbitrario di campi JSONB.
// ==========================================
model CategoryTemplate {
  id        String   @id @default(cuid())
  name      String   @unique   // Deve corrispondere a Product.category
  icon      String?
  fields    String               // FieldDef[] — vedi types/template.ts (JSON string per SQLite)
  isSystem  Boolean  @default(false) // I template di sistema non sono eliminabili
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ==========================================
// INVENTORY LOG (tracciamento mutazioni — mai DELETE, sempre append)
// Pilastro 1: Audit granulare per ogni campo modificato.
// Pilastro 2: Registro della macchina a stati.
// ==========================================
model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  userId    String
  action    String   // "STATUS_CHANGE" | "PRICE_CHANGE" | "ATTR_CHANGE" | "RESERVE" | "RELEASE" | "SOFT_DELETE"
  field     String?  // Campo modificato (es. "purchasePrice", "status")
  oldValue  String?
  newValue  String?
  note      String?
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// FEEDBACK / RICHIESTE — Aiuto & Assistenza
// L'utente invia una richiesta; l'admin la vede e risponde (la risposta
// arriva via email all'utente). Vedi routes/feedback.ts e admin.ts.
// ==========================================
model Feedback {
  id         String    @id @default(cuid())
  userId     String?   // null se l'utente è stato eliminato
  userEmail  String
  userName   String?
  type       String    @default("altro") // "bug" | "idea" | "domanda" | "altro"
  message    String
  status     String    @default("nuova")  // "nuova" | "risposta"
  reply      String?   // testo della risposta dell'admin
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

// ==========================================
// PUSH — notifiche push (Web Push) per dispositivo/browser
// ==========================================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Config app key/value (es. chiavi VAPID generate al primo avvio)
model Setting {
  key   String @id
  value String
}

// ==========================================
// MARKETPLACE CHAT — conversazione acquirente↔venditore su un articolo pubblico.
// Solo testo: niente link né foto (anti-truffa).
// ==========================================
model Conversation {
  id         String    @id @default(cuid())
  productId  String
  sellerId   String
  buyerId    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  agreedPrice Float?   // prezzo concordato via offerta accettata (usato all'acquisto)
  messages   Message[]

  @@unique([productId, buyerId]) // un thread per acquirente/articolo
  @@index([sellerId])
  @@index([buyerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime @default(now())
  readAt         DateTime?
  offerAmount    Float?   // se è un'offerta di prezzo
  offerStatus    String?  // "pending" | "accepted" | "declined"

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==========================================
// EXPENSE — costi extra fuori dai prodotti (sacchetti, spedizioni, materiali, ecc.)
// Servono per il conteggio reale dell'utile e per l'export CSV del commercialista.
// ==========================================
model Expense {
  id          String   @id @default(cuid())
  warehouseId String
  userId      String   // chi l'ha inserito
  amount      Float
  description String
  category    String?  // es. "Sacchetti", "Spedizioni", "Materiali", "Altro"
  date        DateTime @default(now()) // data di competenza del costo
  createdAt   DateTime @default(now())

  @@index([warehouseId])
  @@index([date])
}

// ==========================================
// CATALOG ITEM — cache LEGGERA del catalogo StockX (stile "Aggiungi prodotti").
// L'utente cerca un modello e lo aggiunge al magazzino con la FOTO UFFICIALE (sfondo
// uniforme) invece di scattarla. Salviamo SOLO il LINK dell'immagine StockX (niente
// Cloudinary, niente storage occupato): la foto resta sul CDN di StockX.
// Serve a non ribussare a StockX a ogni ricerca (hanno limiti di chiamate).
// ==========================================
model CatalogItem {
  id            String   @id @default(cuid())
  key           String   @unique   // sku || stockxProductId || titolo normalizzato (dedup)
  brand         String
  name          String
  sku           String?            // style code (es. DV1748-100)
  productType   String?            // "sneakers" | "apparel" | ... (dal productType StockX)
  image         String?            // LINK diretto immagine StockX (NON Cloudinary)
  stockxProductId String?
  useCount      Int      @default(0) // quante volte è stato aggiunto (ordina i più usati in cima)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([sku])
  @@index([productType])
}

// ==========================================
// MANUAL MONTH — dati economici INSERITI A MANO per mesi PRECEDENTI all'apertura del conto HQ
// (o comunque non tracciati in-app). L'utente registra fatturato/costi di un mese passato così
// le analitiche storiche sono complete. profit = revenue - cost (calcolato lato client).
// ==========================================
model ManualMonth {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int      // 0-11 (come JS Date.getMonth)
  revenue   Float    @default(0)
  cost      Float    @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
}
